{
  "name": "nextcommandcenter",
  "version": "1.0.0",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "start": "npm run backend:build && npm run grafana:restart && npm run frontend:dev",
    "frontend:dev": "npm run dev",
    "frontend:build": "npm run build",
    "backend:build": "go run github.com/magefile/mage@v1.15.0 build:darwinARM64",
    "backend:build:all": "go run github.com/magefile/mage@v1.15.0 -v",
    "backend:reload": "npm run backend:build && npm run grafana:restart",
    "build:all": "npm run frontend:build && npm run backend:build:all",
    "grafana:setup": "brew install grafana && npm run grafana:link && npm run grafana:allow-unsigned",
    "grafana:link": "mkdir -p /opt/homebrew/var/lib/grafana/plugins && ln -sfn \"$PWD/dist\" /opt/homebrew/var/lib/grafana/plugins/mcd-nextcommandcenter-app",
    "grafana:allow-unsigned": "node scripts/allow-unsigned.mjs",
    "grafana:start": "brew services start grafana",
    "grafana:stop": "brew services stop grafana",
    "grafana:restart": "brew services restart grafana",
    "grafana:open": "open http://localhost:3000/a/mcd-nextcommandcenter-app",
    "grafana:logs": "tail -f /opt/homebrew/var/log/grafana/grafana.log",
    "sign:private": "sign-plugin --distDir release/mcd-nextcommandcenter-app --rootUrls https://mcdobservability.grafana.net",
    "package:private": "npm run build:all && rm -rf release && mkdir release && cp -R dist release/mcd-nextcommandcenter-app && npm run sign:private && cd release && zip -qr mcd-nextcommandcenter-app-$npm_package_version.zip mcd-nextcommandcenter-app && shasum mcd-nextcommandcenter-app-$npm_package_version.zip && echo Ready: release/mcd-nextcommandcenter-app-$npm_package_version.zip",
    "sign:public": "sign-plugin --distDir release/mcd-nextcommandcenter-app",
    "package:public": "npm run build:all && rm -rf release && mkdir release && cp -R dist release/mcd-nextcommandcenter-app && npm run sign:public && cd release && zip -qr mcd-nextcommandcenter-app-$npm_package_version.zip mcd-nextcommandcenter-app && shasum mcd-nextcommandcenter-app-$npm_package_version.zip && echo Ready: release/mcd-nextcommandcenter-app-$npm_package_version.zip"
  },
  "author": "Mcd",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^4.0.0",
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@svgr/webpack": "8.1.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "7946.0.16",
    "@types/google.maps": "3.66.10",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supercluster": "7.1.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^52.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.106.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "6.0.1",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=24.5"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/google-maps": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@emotion/css": "11.10.6",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@grafana/data": "13.3.1",
    "@grafana/i18n": "13.3.1",
    "@grafana/runtime": "13.3.1",
    "@grafana/scenes": "^8.17.0",
    "@grafana/schema": "13.3.1",
    "@grafana/ui": "13.3.1",
    "@luma.gl/webgpu": "9.4.2",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "chart.js": "4.6.1",
    "lodash": "4.18.1",
    "react": "^19.0.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.22.0",
    "rxjs": "7.8.2",
    "supercluster": "8.0.1",
    "three": "0.169.0"
  },
  "packageManager": "npm@11.4.2",
  "description": "NEXT Command Center: store map, store view, incidents and cases, and Agent Q, inside Grafana."
}
